{
  "name": "octa-squad",
  "version": "0.2.0",
  "private": true,
  "description": "オクタ小隊戦記 — クォータビューのリアルタイム戦術ゲーム（Phaser 3 + エンジン非依存のTypeScript ECSコア）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent": "tsx tools/agent-headless.ts",
    "analyze": "tsx tools/analyze-replay.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.47.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
